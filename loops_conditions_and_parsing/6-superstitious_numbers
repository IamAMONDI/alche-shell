#!/usr/bin/env bash
#uses  the if, elif and else statements
counter=1

while [ $counter -le 20 ]
do
    case $counter in
        3)
            echo $counter
            echo "bad luck from China"
            ;;
        6)
            echo $counter
            echo "bad luck from Japan"
            ;;
        17)
            echo $counter
            echo "bad luck from Italy"
            ;;
        *)
            echo $counter
            ;;
    esac
    ((counter++))
done
